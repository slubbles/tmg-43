# Factory stack env — no secrets required for build
# Optional: point contact/schedule/newsletter forms at your ops endpoints.
# Unset vars leave the corresponding feature offline-safe (forms show a fallback state).
WEBHOOK_URL_CONTACT=
WEBHOOK_URL_SCHEDULE=
WEBHOOK_URL_NEWSLETTER=

# Sentry (optional; env-only wiring, no prod secrets)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Ops lead-routing webhook (never exposed to the client site)
LEAD_OPS_WEBHOOK_URL=
